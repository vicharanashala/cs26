PORT=5000
MONGO_URI=
JWT_SECRET=your_jwt_secret_here
CLIENT_ORIGIN=http://localhost:5173

# Optional: OpenAI API key for Yaksha Mini AI Chat streaming (GPT-3.5-turbo)
